# ============================================================================
# Sentinel 环境变量配置示例
# ============================================================================
# 说明：
# 1. 复制此文件为 .env 并填入真实值
# 2. .env 文件不会被提交到版本控制
# 3. 生产环境必须配置所有必需的环境变量
# 4. 开发环境可以使用默认值

# ============================================================================
# 应用配置
# ============================================================================
# Spring 激活的配置文件（dev/test/prod）
SPRING_PROFILES_ACTIVE=dev

# 服务器端口
SERVER_PORT=8080

# ============================================================================
# 数据库配置（必需）
# ============================================================================
# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_NAME=sentinel

# 数据库用户名
DB_USERNAME=root

# 数据库密码（生产环境必需）
DB_PASSWORD=your_database_password

# 数据库连接池配置（可选）
DB_POOL_MAX_SIZE=50
DB_POOL_MIN_IDLE=20

# ============================================================================
# Redis 配置（必需）
# ============================================================================
# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（如果设置了密码）
REDIS_PASSWORD=

# Redis 数据库索引
REDIS_DATABASE=0

# Redis 是否启用 SSL
REDIS_SSL=false

# ============================================================================
# JWT 配置（必需）
# ============================================================================
# JWT 密钥（生产环境必须使用强密钥，至少32位）
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT 访问令牌过期时间（毫秒，默认1小时）
JWT_EXPIRATION=3600000

# JWT 刷新令牌过期时间（毫秒，默认1天）
JWT_REFRESH_EXPIRATION=86400000

# ============================================================================
# 安全配置（可选）
# ============================================================================
# 最大登录尝试次数
SECURITY_MAX_ATTEMPTS=5

# 账户锁定时间（分钟）
SECURITY_LOCK_TIME=15

# CORS 允许的源（多个用逗号分隔）
CORS_ALLOWED_ORIGIN_1=https://your-frontend-domain.com
CORS_ALLOWED_ORIGIN_2=

# ============================================================================
# 缓存配置（可选）
# ============================================================================
# AI 诊断缓存 TTL（秒）
CACHE_DIAGNOSIS_TTL=86400

# 系统指标缓存 TTL（秒）
CACHE_METRICS_TTL=300

# Token 黑名单缓存 TTL（秒）
CACHE_TOKEN_BLACKLIST_TTL=86400

# 缓存键前缀
CACHE_KEY_PREFIX=sentinel:

# ============================================================================
# AI 服务配置
# ============================================================================
# AI 提供商类型（ollama/openai/custom）
AI_PROVIDER=ollama

# --- Ollama 配置（本地 AI 服务） ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- OpenAI 配置（云端 AI 服务） ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=60
OPENAI_MAX_TOKENS=2000

# --- 自定义 AI 配置（OpenAI 兼容 API） ---
CUSTOM_AI_BASE_URL=https://your-custom-ai-api.com/v1
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=your-model-name
CUSTOM_AI_TIMEOUT=60

# ============================================================================
# Docker 配置（可选）
# ============================================================================
# Docker 主机地址
DOCKER_HOST=unix:///var/run/docker.sock

# Docker API 版本
DOCKER_API_VERSION=1.41

# Docker TLS 验证
DOCKER_TLS_VERIFY=false

# Docker TLS 证书路径
DOCKER_CERT_PATH=

# Docker 连接超时（秒）
DOCKER_CONNECTION_TIMEOUT=30

# Docker 响应超时（秒）
DOCKER_RESPONSE_TIMEOUT=60

# Docker 网络名称
DOCKER_NETWORK=sentinel-network

# Docker 容器名称前缀
DOCKER_NAME_PREFIX=sentinel-

# Docker 容器内存限制（MB）
DOCKER_MEMORY_LIMIT=512

# Docker 容器 CPU 限制（核心数）
DOCKER_CPU_LIMIT=1.0

# Docker 容器重启策略
DOCKER_RESTART_POLICY=unless-stopped

# ============================================================================
# 日志配置（可选）
# ============================================================================
# 日志文件路径
LOG_FILE=/var/log/sentinel/sentinel.log

# 日志文件最大大小
LOG_MAX_SIZE=500MB

# 日志文件保留天数
LOG_MAX_HISTORY=90

# ============================================================================
# SSL/HTTPS 配置（生产环境推荐）
# ============================================================================
# 是否启用 HTTPS
SERVER_SSL_ENABLED=false

# SSL 证书路径
SERVER_SSL_KEY_STORE=/path/to/keystore.p12

# SSL 证书密码
SERVER_SSL_KEY_STORE_PASSWORD=your_keystore_password

# SSL 证书类型
SERVER_SSL_KEY_STORE_TYPE=PKCS12

# ============================================================================
# Docker Compose 配置（用于本地开发）
# ============================================================================
# MySQL Root 密码
MYSQL_ROOT_PASSWORD=root

# MySQL 数据库名称
MYSQL_DATABASE=sentinel

# Redis 密码（留空表示无密码）
REDIS_PASSWORD_DOCKER=
