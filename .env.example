# ============================================================================
# Sentinel 环境变量配置示例
# ============================================================================
# 说明：
# 1. 复制此文件为 .env 并填入真实值
# 2. .env 文件不会被提交到版本控制
# 3. 生产环境必须配置所有必需的环境变量
# 4. 开发环境可以使用默认值

# ============================================================================
# 应用配置
# ============================================================================
# Spring 激活的配置文件（dev/test/prod）
SPRING_PROFILES_ACTIVE=dev

# 服务器端口
SERVER_PORT=8080

# ============================================================================
# 数据库配置（必需）
# ============================================================================
# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_NAME=sentinel

# 数据库用户名
DB_USERNAME=root

# 数据库密码（生产环境必需）
DB_PASSWORD=change_me_mysql_root

# 数据库连接池配置（可选）
DB_POOL_MAX_SIZE=50
DB_POOL_MIN_IDLE=20

# ============================================================================
# Redis 配置（必需）
# ============================================================================
# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码，应用与 Compose 共用，必填
REDIS_PASSWORD=change_me_redis

# Redis 数据库索引
REDIS_DATABASE=0

# Redis 是否启用 SSL
REDIS_SSL=false

# ============================================================================
# JWT 配置（必需）
# ============================================================================
# JWT 密钥（必需）。长度必须 >= 32 个字符；缺失、短于 32 或仍是未解析的 ${...} 占位符时应用拒绝启动。
# 下面的示例带 change_me，启动检查会拒绝它。请换成随机值：openssl rand -base64 48
# 也不能包含 change-in-production、your-super-secret、changeme、change_me，且至少要有 8 个不同字符。
JWT_SECRET=change_me_replace_this_jwt_secret_min_32_characters

# 启动时若该值非空，把用户 admin 的密码重置为它的 BCrypt 哈希；没有 admin 则创建（角色 ADMIN）。
# 长度至少 12，更短会拒绝启动。日志不会打印该值。
# 生产请 openssl rand -base64 18 生成后导出，不要取消下面这行的注释直接使用。
# SENTINEL_ADMIN_PASSWORD=change_me_admin_min_12

# JWT 访问令牌过期时间（毫秒，默认1小时）
JWT_EXPIRATION=3600000

# JWT 刷新令牌过期时间（毫秒，默认1天）
JWT_REFRESH_EXPIRATION=86400000

# ============================================================================
# 安全配置（可选）
# ============================================================================
# 最大登录尝试次数
SECURITY_MAX_ATTEMPTS=5

# 账户锁定时间（分钟）
SECURITY_LOCK_TIME=15

# CORS 允许的源（多个用逗号分隔）
CORS_ALLOWED_ORIGIN_1=https://your-frontend-domain.com
CORS_ALLOWED_ORIGIN_2=

# ============================================================================
# 缓存配置（可选）
# ============================================================================
# AI 诊断缓存 TTL（秒）
CACHE_DIAGNOSIS_TTL=86400

# 系统指标缓存 TTL（秒）
CACHE_METRICS_TTL=300

# Token 黑名单缓存 TTL（秒）
CACHE_TOKEN_BLACKLIST_TTL=86400

# 缓存键前缀
CACHE_KEY_PREFIX=sentinel:

# ============================================================================
# AI 服务配置
# ============================================================================
# 调用顺序（逗号分隔，前者优先）。未设置时回退到下面的 AI_PROVIDER。
# DeepSeek 优先、本地 Ollama 兜底：AI_PROVIDER_ORDER=deepseek,ollama
AI_PROVIDER_ORDER=ollama
# 旧的单提供商变量，仅在 AI_PROVIDER_ORDER 未设置时生效
AI_PROVIDER=ollama

# 协议三种：
#   openai    — POST {base-url}/chat/completions，Authorization: Bearer
#   anthropic — POST {base-url}/v1/messages，请求头 x-api-key 与 anthropic-version
#   ollama    — POST {base-url}/api/chat
# 新增一个 OpenAI / Anthropic 兼容提供商：在 application.yml 的 ai.providers 下加一项
# （protocol、base-url、api-key、model），再把名字写进 AI_PROVIDER_ORDER。
# 每个提供商还可在 yml 里设置 timeout（秒，默认 60）、max-tokens（默认 2000）、
# temperature（默认 0.3）、enabled（默认 true）。
#
# 部分「coding plan / 编程套餐」只允许指定的编程工具调用，不能当作通用 API。
# 接入前请核对提供商条款。

# --- Ollama（本地，只需要 base-url） ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- DeepSeek（OpenAI 兼容 https://api.deepseek.com ，Anthropic 兼容 https://api.deepseek.com/anthropic） ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
# 推理开关：disabled / enabled / 留空（unset，不发送该字段）。
# deepseek-flash 是推理模型，默认 disabled，否则思考内容可能占满 max-tokens，正文为空。
DEEPSEEK_THINKING=disabled

# --- 自定义提供商（默认按 OpenAI 兼容协议） ---
CUSTOM_AI_PROTOCOL=openai
CUSTOM_AI_BASE_URL=https://your-custom-ai-api.com/v1
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=your-model-name

# ============================================================================
# Docker 配置（可选）
# ============================================================================
# Docker 主机地址
DOCKER_HOST=unix:///var/run/docker.sock

# Docker API 版本
DOCKER_API_VERSION=1.41

# Docker TLS 验证
DOCKER_TLS_VERIFY=false

# Docker TLS 证书路径
DOCKER_CERT_PATH=

# Docker 连接超时（秒）
DOCKER_CONNECTION_TIMEOUT=30

# Docker 响应超时（秒）
DOCKER_RESPONSE_TIMEOUT=60

# Docker 网络名称
DOCKER_NETWORK=sentinel-network

# Docker 容器名称前缀
DOCKER_NAME_PREFIX=sentinel-

# Docker 容器内存限制（MB）
DOCKER_MEMORY_LIMIT=512

# Docker 容器 CPU 限制（核心数）
DOCKER_CPU_LIMIT=1.0

# Docker 容器重启策略
DOCKER_RESTART_POLICY=unless-stopped

# ============================================================================
# 日志配置（可选）
# ============================================================================
# 日志文件路径
LOG_FILE=/var/log/sentinel/sentinel.log

# 日志文件最大大小
LOG_MAX_SIZE=500MB

# 日志文件保留天数
LOG_MAX_HISTORY=90

# ============================================================================
# SSL/HTTPS 配置（生产环境推荐）
# ============================================================================
# 是否启用 HTTPS
SERVER_SSL_ENABLED=false

# SSL 证书路径
SERVER_SSL_KEY_STORE=/path/to/keystore.p12

# SSL 证书密码
SERVER_SSL_KEY_STORE_PASSWORD=your_keystore_password

# SSL 证书类型
SERVER_SSL_KEY_STORE_TYPE=PKCS12

# ============================================================================
# Docker Compose 配置（用于本地开发）
# ============================================================================
# Compose 没有默认密码，以下三项必填。可用 openssl rand -hex 20 生成
# MySQL Root 密码（DB_PASSWORD 需与它相同）
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# MySQL 普通账号 sentinel 的密码
MYSQL_PASSWORD=change_me_mysql_user

# MySQL 数据库名称
MYSQL_DATABASE=sentinel

# Compose 只把端口绑定到这个地址，改成 0.0.0.0 会暴露到外网
BIND_ADDRESS=127.0.0.1
