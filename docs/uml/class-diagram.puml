@startuml Sentinel类图
' ============================================
' Sentinel 智能体系统 - UML 2.x 类图
' 版本: v2.0 (单体架构精简版)
' 日期: 2025-12-16
' ============================================

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle

title Sentinel 单体架构类图

' ============================================
' 核心领域模型 (精简为5个核心实体)
' ============================================
package "领域模型 (Domain Model)" #LightBlue {
    
    class Task {
        - id: Long
        - taskCode: String
        - serviceId: String
        - testType: TestType
        - dependencies: List<String>
        - status: TaskStatus
        - priority: Integer
        - environmentId: Long
        - errorMessage: String
        - createdAt: LocalDateTime
        - startedAt: LocalDateTime
        - completedAt: LocalDateTime
        --
        + start(): void
        + complete(): void
        + fail(errorMessage: String): void
        + cancel(): void
    }
    
    enum TestType {
        UNIT_TEST
        INTEGRATION_TEST
        E2E_TEST
    }
    
    enum TaskStatus {
        PENDING
        QUEUED
        RUNNING
        SUCCESS
        FAILED
        CANCELLED
    }
    
    class Environment {
        - id: Long
        - envCode: String
        - taskId: Long
        - status: EnvironmentStatus
        - composeContent: String
        - accessUrl: String
        - portMappings: Map<String, Integer>
        - resourceUsage: Map<String, Object>
        - expiresAt: LocalDateTime
        - createdAt: LocalDateTime
        --
        + acquire(taskId: Long): void
        + release(): void
        + isReusable(): boolean
    }
    
    enum EnvironmentStatus {
        CREATING
        READY
        BUSY
        RELEASING
        IDLE
        ERROR
    }
    
    class DiagnosisCache {
        - id: Long
        - logHash: String
        - errorType: ErrorType
        - severity: Severity
        - rootCause: String
        - suggestions: List<String>
        - hitCount: Integer
        - confidence: Double
        - createdAt: LocalDateTime
        - expiredAt: LocalDateTime
        --
        + incrementHitCount(): void
        + isExpired(): boolean
    }
    
    enum ErrorType {
        RESOURCE_EXHAUSTED
        NETWORK_ERROR
        DEPENDENCY_FAILURE
        TIMEOUT
        CONFIG_ERROR
        UNKNOWN
    }
    
    enum Severity {
        LOW
        MEDIUM
        HIGH
        CRITICAL
    }
    
    class SystemConfig {
        - id: Long
        - configKey: String
        - configValue: String
        - description: String
        - updatedAt: LocalDateTime
        --
        + getValue(): String
        + getIntValue(): Integer
        + getBoolValue(): Boolean
    }
    
    class User {
        - id: Long
        - username: String
        - password: String
        - email: String
        - role: UserRole
        - enabled: Boolean
        - lastLoginAt: LocalDateTime
        - createdAt: LocalDateTime
        --
        + isAdmin(): boolean
        + isEnabled(): boolean
    }
    
    enum UserRole {
        ADMIN
        USER
    }
    
    class OperationLog {
        - id: Long
        - operator: String
        - operation: String
        - targetType: String
        - targetId: String
        - detail: String
        - createdAt: LocalDateTime
    }
}

' ============================================
' 智能体核心模块 (Agent Core)
' ============================================
package "智能体核心 (Agent Core)" #LightGreen {
    
    interface Perceiver {
        + perceive(): TaskRequest
        + getMetrics(): SystemMetrics
    }
    
    interface DecisionEngine {
        + decide(request: TaskRequest, metrics: SystemMetrics): Decision
    }
    
    interface Actuator {
        + execute(decision: Decision): ActionResult
    }
    
    class AgentBrain {
        - perceiver: Perceiver
        - decisionEngine: DecisionEngine
        - actuator: Actuator
        - eventPublisher: ApplicationEventPublisher
        --
        + process(request: TaskRequest): ActionResult
        - perceive(): SystemMetrics
        - decide(request: TaskRequest, metrics: SystemMetrics): Decision
        - execute(decision: Decision): ActionResult
        - publishEvent(event: BaseEvent): void
    }
    
    class Decision {
        - action: ActionType
        - taskId: Long
        - reuseEnvironmentId: Long
        - containerSpec: ContainerSpec
        - reason: String
        --
        + isCreate(): boolean
        + isReuse(): boolean
        + isEnqueue(): boolean
    }
    
    enum ActionType {
        CREATE_NOW
        REUSE_ENVIRONMENT
        ENQUEUE
        REJECT
    }
    
    class ActionResult {
        - success: boolean
        - environmentId: Long
        - containerId: String
        - errorCode: String
        - errorMessage: String
        - logs: String
        - duration: Long
        --
        + isFailure(): boolean
        + getLogHash(): String
    }
    
    class TaskRequest {
        - taskId: Long
        - taskCode: String
        - serviceId: String
        - testType: TestType
        - dependencies: List<String>
        - priority: Integer
        --
        + validate(): boolean
    }
    
    class SystemMetrics {
        - cpuUsage: Double
        - memoryUsage: Double
        - diskUsage: Double
        - runningContainers: Integer
        - availableEnvironments: Integer
        - timestamp: LocalDateTime
        --
        + isHealthy(): boolean
        + canAcceptTask(): boolean
    }
    
    class ResourceLimits {
        - cpuLimit: String
        - memoryLimit: String
        - diskLimit: String
    }
    
    class ContainerSpec {
        - image: String
        - command: String
        - envVars: Map<String, String>
        - resourceLimits: ResourceLimits
        - securityOptions: SecurityOptions
    }
    
    class SecurityOptions {
        - runAsNonRoot: boolean
        - readOnlyRootFilesystem: boolean
        - allowPrivilegeEscalation: boolean
        - dropCapabilities: List<String>
    }
}

' ============================================
' 感知器实现 (Sensors)
' ============================================
package "感知器 (Sensors)" #LightYellow {
    
    class DockerSensor implements Perceiver {
        - dockerClient: DockerClient
        --
        + getMetrics(): SystemMetrics
        + getContainerStats(containerId: String): ContainerStats
        + listContainers(): List<Container>
    }
    
    class TaskQueueSensor implements Perceiver {
        - taskQueue: BlockingQueue<TaskRequest>
        --
        + perceive(): TaskRequest
        + getQueueSize(): Integer
        + peekNext(): TaskRequest
    }
}

' ============================================
' 决策引擎实现 (Decision Engines)
' ============================================
package "决策引擎 (Decision Engines)" #LightPink {
    
    class RuleEngine implements DecisionEngine {
        - rules: List<Rule>
        --
        + decide(request: TaskRequest, metrics: SystemMetrics): Decision
        + loadRules(): void
        + evaluateRules(context: RuleContext): Decision
    }
    
    class Rule {
        - id: Long
        - name: String
        - condition: String
        - action: ActionType
        - priority: Integer
        - enabled: boolean
        --
        + evaluate(context: RuleContext): boolean
    }
    
    class RuleContext {
        - request: TaskRequest
        - metrics: SystemMetrics
        - availableEnvironments: List<Environment>
    }
    
    class LLMAdvisor implements DecisionEngine {
        - ollamaClient: OllamaClient
        - promptTemplate: String
        --
        + decide(request: TaskRequest, metrics: SystemMetrics): Decision
        + analyze(logs: String): DiagnosisResult
        - buildPrompt(context: String): String
    }
    
    class HybridDecisionEngine implements DecisionEngine {
        - ruleEngine: RuleEngine
        - llmAdvisor: LLMAdvisor
        - llmThreshold: Double
        --
        + decide(request: TaskRequest, metrics: SystemMetrics): Decision
        - shouldUseLLM(metrics: SystemMetrics): boolean
    }
    
    class DiagnosisResult {
        - errorType: ErrorType
        - severity: Severity
        - rootCause: String
        - suggestions: List<String>
        - confidence: Double
        - fromCache: boolean
    }
}

' ============================================
' 执行器实现 (Actuators)
' ============================================
package "执行器 (Actuators)" #LightCoral {
    
    class DockerActuator implements Actuator {
        - dockerClient: DockerClient
        --
        + execute(decision: Decision): ActionResult
        + createContainer(spec: ContainerSpec): String
        + startContainer(containerId: String): void
        + stopContainer(containerId: String): void
        + removeContainer(containerId: String): void
        + getContainerLogs(containerId: String, tail: Integer): String
    }
}

' ============================================
' 持久层 (Repositories)
' ============================================
package "持久层 (Repositories)" #PaleGreen {
    
    interface TaskRepository {
        + findById(id: Long): Optional<Task>
        + findByTaskCode(taskCode: String): Optional<Task>
        + findByStatus(status: TaskStatus): List<Task>
        + findByServiceId(serviceId: String): List<Task>
        + save(task: Task): Task
        + deleteById(id: Long): void
    }
    
    interface EnvironmentRepository {
        + findById(id: Long): Optional<Environment>
        + findByEnvCode(envCode: String): Optional<Environment>
        + findByStatus(status: EnvironmentStatus): List<Environment>
        + findByTaskId(taskId: Long): Optional<Environment>
        + save(environment: Environment): Environment
        + deleteById(id: Long): void
    }
    
    interface ContainerRepository {
        + findById(id: Long): Optional<Container>
        + findByEnvironmentId(environmentId: Long): List<Container>
        + findByContainerId(containerId: String): Optional<Container>
        + save(container: Container): Container
        + deleteById(id: Long): void
    }
    
    interface DiagnosisCacheRepository {
        + findByLogHash(logHash: String): Optional<DiagnosisCache>
        + save(cache: DiagnosisCache): DiagnosisCache
        + incrementHitCount(logHash: String): void
        + deleteExpired(days: Integer): Integer
    }
    
    interface UserRepository {
        + findById(id: Long): Optional<User>
        + findByUsername(username: String): Optional<User>
        + save(user: User): User
        + existsByUsername(username: String): boolean
    }
    
    interface SystemConfigRepository {
        + findByConfigKey(key: String): Optional<SystemConfig>
        + findAll(): List<SystemConfig>
        + save(config: SystemConfig): SystemConfig
    }
}

' ============================================
' 服务层 (Services)
' ============================================
package "服务层 (Services)" #Wheat {
    
    class TaskService {
        - taskRepository: TaskRepository
        - agentBrain: AgentBrain
        - eventPublisher: ApplicationEventPublisher
        --
        + createTask(request: CreateTaskRequest): Task
        + getTask(taskId: Long): Task
        + getTaskStatus(taskId: Long): TaskStatus
        + getTaskLogs(taskId: Long, tail: Integer): String
        + cancelTask(taskId: Long): void
        + listTasks(filter: TaskFilter, pageable: Pageable): Page<Task>
    }
    
    class EnvironmentService {
        - environmentRepository: EnvironmentRepository
        - dockerActuator: DockerActuator
        - eventPublisher: ApplicationEventPublisher
        --
        + createEnvironment(task: Task): Environment
        + getEnvironment(envId: Long): Environment
        + releaseEnvironment(envId: Long): void
        + findIdleEnvironment(): Environment
        + listEnvironments(status: EnvironmentStatus): List<Environment>
    }
    
    class MetricsService {
        - dockerSensor: DockerSensor
        - redisTemplate: RedisTemplate
        --
        + getCurrentMetrics(): SystemMetrics
        + recordMetrics(metrics: SystemMetrics): void
        + checkHealth(): HealthStatus
    }
    
    class DiagnosisService {
        - llmAdvisor: LLMAdvisor
        - diagnosisCacheRepository: DiagnosisCacheRepository
        - eventPublisher: ApplicationEventPublisher
        --
        + diagnose(taskId: Long): DiagnosisResult
        + getDiagnosis(taskId: Long): DiagnosisResult
        + requestDiagnosis(taskId: Long, forceRefresh: boolean): Long
        - getCachedDiagnosis(logHash: String): DiagnosisResult
        - saveDiagnosis(logHash: String, result: DiagnosisResult): void
    }
}

' ============================================
' 事件模块 (Events - 替代 Kafka)
' ============================================
package "事件模块 (Events)" #Lavender {
    
    abstract class BaseEvent {
        - eventId: String
        - eventType: String
        - timestamp: LocalDateTime
        - source: String
    }
    
    class TaskCreatedEvent extends BaseEvent {
        - taskId: Long
        - taskName: String
        - taskType: TaskType
    }
    
    class TaskCompletedEvent extends BaseEvent {
        - taskId: Long
        - exitCode: Integer
        - duration: Long
    }
    
    class TaskFailedEvent extends BaseEvent {
        - taskId: Long
        - errorMessage: String
        - logs: String
    }
    
    class EnvironmentReadyEvent extends BaseEvent {
        - environmentId: Long
        - containerId: String
    }
    
    class EnvironmentReleasedEvent extends BaseEvent {
        - environmentId: Long
        - taskId: Long
    }
    
    class DiagnosisCompletedEvent extends BaseEvent {
        - diagnosisId: Long
        - taskId: Long
        - fromCache: boolean
    }
    
    class ResourceThresholdExceededEvent extends BaseEvent {
        - resourceType: String
        - currentValue: Double
        - threshold: Double
    }
}

' ============================================
' 事件监听器 (Event Listeners)
' ============================================
package "事件监听器 (Event Listeners)" #Thistle {
    
    class TaskEventListener {
        - environmentService: EnvironmentService
        - metricsService: MetricsService
        --
        + onTaskCreated(event: TaskCreatedEvent): void
        + onTaskCompleted(event: TaskCompletedEvent): void
    }
    
    class FailureEventListener {
        - diagnosisService: DiagnosisService
        --
        + onTaskFailed(event: TaskFailedEvent): void
    }
    
    class EnvironmentEventListener {
        - taskService: TaskService
        --
        + onEnvironmentReady(event: EnvironmentReadyEvent): void
        + onEnvironmentReleased(event: EnvironmentReleasedEvent): void
    }
}

' ============================================
' 控制器层 (Controllers)
' ============================================
package "控制器层 (Controllers)" #MistyRose {
    
    class AuthController {
        - authService: AuthService
        --
        + login(request: LoginRequest): ResponseEntity<LoginResponse>
        + getCurrentUser(): ResponseEntity<UserInfo>
    }
    
    class TaskController {
        - taskService: TaskService
        --
        + createTask(request: CreateTaskRequest): ResponseEntity<Task>
        + getTask(taskId: Long): ResponseEntity<Task>
        + getTaskStatus(taskId: Long): ResponseEntity<TaskStatus>
        + getTaskLogs(taskId: Long, tail: Integer): ResponseEntity<String>
        + cancelTask(taskId: Long): ResponseEntity<Void>
        + listTasks(filter: TaskFilter, pageable: Pageable): ResponseEntity<Page<Task>>
    }
    
    class EnvironmentController {
        - environmentService: EnvironmentService
        --
        + getEnvironment(envId: Long): ResponseEntity<Environment>
        + releaseEnvironment(envId: Long): ResponseEntity<Void>
        + listEnvironments(status: EnvironmentStatus): ResponseEntity<List<Environment>>
    }
    
    class MetricsController {
        - metricsService: MetricsService
        --
        + getSystemMetrics(): ResponseEntity<SystemMetrics>
        + healthCheck(): ResponseEntity<HealthStatus>
    }
    
    class DiagnosisController {
        - diagnosisService: DiagnosisService
        --
        + getDiagnosis(taskId: Long): ResponseEntity<DiagnosisResult>
        + requestDiagnosis(taskId: Long, forceRefresh: boolean): ResponseEntity<Long>
    }
}

' ============================================
' 关系定义
' ============================================

' 领域模型关系
Task --> TestType
Task --> TaskStatus
Task "1" -- "0..1" Environment : uses
Environment --> EnvironmentStatus
DiagnosisCache --> ErrorType
DiagnosisCache --> Severity

' 智能体核心关系
AgentBrain --> Perceiver : uses
AgentBrain --> DecisionEngine : uses
AgentBrain --> Actuator : uses
Decision --> ActionType
Decision --> ContainerSpec
ContainerSpec --> ResourceLimits
ContainerSpec --> SecurityOptions

' 实现关系
DockerSensor ..|> Perceiver
TaskQueueSensor ..|> Perceiver
RuleEngine ..|> DecisionEngine
LLMAdvisor ..|> DecisionEngine
HybridDecisionEngine ..|> DecisionEngine
DockerActuator ..|> Actuator

' 组合关系
HybridDecisionEngine *-- RuleEngine
HybridDecisionEngine *-- LLMAdvisor
RuleEngine *-- Rule

' 服务层关系
TaskService --> TaskRepository
TaskService --> AgentBrain
EnvironmentService --> EnvironmentRepository
EnvironmentService --> DockerActuator
MetricsService --> DockerSensor
DiagnosisService --> DiagnosisCacheRepository
DiagnosisService --> LLMAdvisor

' 事件关系
TaskEventListener --> EnvironmentService
TaskEventListener --> MetricsService
FailureEventListener --> DiagnosisService
EnvironmentEventListener --> TaskService

' 控制器层关系
TaskController --> TaskService
EnvironmentController --> EnvironmentService
MetricsController --> MetricsService
DiagnosisController --> DiagnosisService

@enduml
