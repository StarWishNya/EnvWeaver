@startuml Sentinel顺序图
' ============================================
' Sentinel 智能体系统 - UML 2.x 顺序图
' 版本: v2.0 (单体架构精简版)
' 日期: 2025-12-16
' ============================================

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200

title Sentinel 智能体系统 - 核心业务流程顺序图（单体架构）

' ============================================
' 顺序图1: 创建测试环境（正常流程）
' ============================================
newpage 场景1: 创建测试环境（正常流程）

actor "CI System\n(Jenkins)" as CI
participant "TaskController" as TaskCtrl
participant "TaskService" as TaskSvc
participant "AgentBrain" as Brain
participant "DockerSensor" as Sensor
participant "RuleEngine" as Rule
participant "DockerActuator" as Actuator
participant "EventPublisher" as Event
database "MySQL" as MySQL
database "Redis" as Redis

CI -> TaskCtrl: POST /api/tasks\n{name, type, image, command}
activate TaskCtrl

TaskCtrl -> TaskCtrl: JWT Token验证
TaskCtrl -> TaskSvc: createTask(request)
activate TaskSvc

TaskSvc -> MySQL: INSERT INTO t_task
MySQL --> TaskSvc: taskId

TaskSvc -> Brain: process(taskRequest)
activate Brain

== 感知阶段 ==

Brain -> Sensor: getMetrics()
activate Sensor
Sensor -> Sensor: 调用Docker Stats API
Sensor --> Brain: SystemMetrics{cpu:45%, mem:60%, containers:8}
deactivate Sensor

== 决策阶段 ==

Brain -> Rule: decide(task, metrics)
activate Rule

alt 资源充足 (mem < 70%)
    Rule -> Rule: 评估规则: memory_usage < 0.7
    Rule --> Brain: Decision{action:CREATE_NOW}
else 资源紧张 (70% <= mem < 85%)
    Rule -> Rule: 评估队列长度
    alt queueSize < 3
        Rule --> Brain: Decision{action:CREATE_NOW}
    else queueSize >= 3
        Rule --> Brain: Decision{action:ENQUEUE}
    end
else 资源不足 (mem >= 85%)
    Rule --> Brain: Decision{action:ENQUEUE}
end
deactivate Rule

== 执行阶段 ==

Brain -> Actuator: execute(decision)
activate Actuator

Actuator -> Actuator: createContainer(spec)
note right
  安全配置:
  - runAsNonRoot: true
  - readOnlyRootFilesystem: true
  - dropCapabilities: [ALL]
end note

Actuator -> Actuator: startContainer()
Actuator -> Actuator: waitForHealthCheck(timeout=60s)

loop 每5秒检查一次
    Actuator -> Actuator: healthCheck()
    alt 健康检查通过
        Actuator -> Actuator: break
    end
end

Actuator -> MySQL: INSERT INTO t_environment\n{containerId, status:BUSY}
MySQL --> Actuator: envId

Actuator --> Brain: ActionResult{success:true, envId, containerId}
deactivate Actuator

Brain -> Event: publishEvent(TaskStartedEvent)
Event -> Event: @Async 异步处理
note right: Spring Events 替代 Kafka

Brain -> Redis: SET task:{taskId}:status = RUNNING
Redis --> Brain: OK

Brain --> TaskSvc: ActionResult
deactivate Brain

TaskSvc -> MySQL: UPDATE t_task SET status='RUNNING'

TaskSvc --> TaskCtrl: Task{id, status, environmentId}
deactivate TaskSvc

TaskCtrl --> CI: 201 Created\n{taskId, envId, status}
deactivate TaskCtrl

' ============================================
' 顺序图2: 环境启动失败 + AI诊断
' ============================================
newpage 场景2: 环境启动失败 + AI诊断

actor "CI System" as CI2
participant "TaskController" as TaskCtrl2
participant "TaskService" as TaskSvc2
participant "AgentBrain" as Brain2
participant "DockerActuator" as Actuator2
participant "EventPublisher" as Event2
participant "FailureEventListener" as Listener
participant "DiagnosisService" as DiagSvc
participant "LLMAdvisor" as LLM
participant "Ollama" as Ollama
database "MySQL" as MySQL2
database "Redis" as Redis2

CI2 -> TaskCtrl2: POST /api/tasks
activate TaskCtrl2

TaskCtrl2 -> TaskSvc2: createTask(request)
activate TaskSvc2

TaskSvc2 -> Brain2: process(taskRequest)
activate Brain2

Brain2 -> Actuator2: execute(decision)
activate Actuator2

Actuator2 -> Actuator2: createContainer()
Actuator2 -> Actuator2: startContainer()
Actuator2 -> Actuator2: waitForHealthCheck()

note over Actuator2: 容器启动超时(>60s)\n或健康检查失败

Actuator2 -> Actuator2: getContainerLogs(tail=100)
Actuator2 --> Brain2: ActionResult{success:false, logs:"Error: port already in use..."}
deactivate Actuator2

Brain2 -> MySQL2: UPDATE t_task SET status='FAILED'

Brain2 -> Event2: publishEvent(TaskFailedEvent)
deactivate Brain2

== 异步 AI 诊断 ==

Event2 ->> Listener: @Async @EventListener
activate Listener

Listener -> DiagSvc: diagnose(taskId)
activate DiagSvc

DiagSvc -> DiagSvc: calculateLogHash(logs)
note right: SHA-256("Error: port...")

DiagSvc -> Redis2: GET diagnosis:{logHash}
Redis2 --> DiagSvc: null (未命中)

DiagSvc -> LLM: analyze(logs)
activate LLM

LLM -> LLM: buildPrompt(logs)
note right
  Prompt模板:
  "你是资深DevOps工程师,
   分析以下Docker启动失败日志:
   {logs}
   请给出JSON格式诊断结果"
end note

LLM -> Ollama: POST /api/generate\n{model:"qwen2.5:7b", prompt}
activate Ollama
note over Ollama: Qwen2.5-7B模型推理\n耗时约5-8秒
Ollama --> LLM: {response: "{\\"rootCause\\":\\"端口冲突\\",...}"}
deactivate Ollama

LLM -> LLM: parseJsonResponse()
LLM --> DiagSvc: DiagnosisResult{rootCause, suggestions}
deactivate LLM

DiagSvc -> MySQL2: INSERT INTO t_diagnosis_cache\n{logHash, result}
DiagSvc -> Redis2: SET diagnosis:{logHash} = result EX 7776000
note right: TTL 90天

DiagSvc -> Event2: publishEvent(DiagnosisCompletedEvent)

DiagSvc --> Listener: DiagnosisResult
deactivate DiagSvc

deactivate Listener

TaskSvc2 --> TaskCtrl2: Task{status:FAILED}
deactivate TaskSvc2

TaskCtrl2 --> CI2: 201 Created\n{taskId, status:FAILED}
deactivate TaskCtrl2

note over CI2: 任务创建成功但执行失败\n诊断结果异步生成

' ============================================
' 顺序图3: 环境复用流程
' ============================================
newpage 场景3: 环境复用流程

actor "CI System" as CI3
participant "TaskController" as TaskCtrl3
participant "TaskService" as TaskSvc3
participant "AgentBrain" as Brain3
participant "DockerSensor" as Sensor3
participant "RuleEngine" as Rule3
participant "EnvironmentService" as EnvSvc
participant "DockerActuator" as Actuator3
database "MySQL" as MySQL3
database "Redis" as Redis3

CI3 -> TaskCtrl3: POST /api/tasks\n{name:"unit-test", type:UNIT_TEST}
activate TaskCtrl3

TaskCtrl3 -> TaskSvc3: createTask(request)
activate TaskSvc3

TaskSvc3 -> Brain3: process(taskRequest)
activate Brain3

Brain3 -> Sensor3: getMetrics()
Sensor3 --> Brain3: SystemMetrics{cpu:70%, mem:75%}

Brain3 -> Rule3: decide(task, metrics)
activate Rule3

Rule3 -> Rule3: 评估资源状态
note right: 资源紧张，优先复用

Rule3 -> EnvSvc: findIdleEnvironment(type)
activate EnvSvc

EnvSvc -> MySQL3: SELECT * FROM t_environment\nWHERE status='READY'
MySQL3 --> EnvSvc: Environment{id:456, containerId:"abc123"}

EnvSvc -> EnvSvc: validateEnvironment()
note right
  验证:
  1. 容器仍在运行
  2. 健康检查通过
end note

EnvSvc --> Rule3: Environment{id:456}
deactivate EnvSvc

Rule3 --> Brain3: Decision{action:REUSE_ENVIRONMENT, reuseEnvironmentId:456}
deactivate Rule3

Brain3 -> Actuator3: execute(decision)
activate Actuator3

Actuator3 -> MySQL3: UPDATE t_environment\nSET status='BUSY', task_id=?\nWHERE id=456
MySQL3 --> Actuator3: OK

Actuator3 -> Actuator3: refreshHealthCheck()

Actuator3 --> Brain3: ActionResult{success:true, environmentId:456, reused:true}
deactivate Actuator3

Brain3 -> Redis3: SET task:{taskId}:status = RUNNING
Brain3 -> Redis3: INCR counter:env_reuse

Brain3 --> TaskSvc3: ActionResult
deactivate Brain3

TaskSvc3 --> TaskCtrl3: Task{environmentId:456, status:RUNNING}
deactivate TaskSvc3

TaskCtrl3 --> CI3: 201 Created\n{taskId, environmentId:456, reused:true}
deactivate TaskCtrl3

note over CI3: 环境复用成功\n启动时间从30s降至<1s

' ============================================
' 顺序图4: 获取诊断结果（缓存命中）
' ============================================
newpage 场景4: 获取诊断结果（缓存命中）

actor "开发人员" as Dev
participant "DiagnosisController" as DiagCtrl
participant "DiagnosisService" as DiagSvc4
database "Redis" as Redis4
database "MySQL" as MySQL4

Dev -> DiagCtrl: GET /api/diagnosis/{taskId}
activate DiagCtrl

DiagCtrl -> DiagSvc4: getDiagnosis(taskId)
activate DiagSvc4

DiagSvc4 -> MySQL4: SELECT * FROM t_task WHERE id=?
MySQL4 --> DiagSvc4: Task{errorMessage, logs}

DiagSvc4 -> DiagSvc4: logHash = SHA256(logs)

DiagSvc4 -> Redis4: GET diagnosis:{logHash}
Redis4 --> DiagSvc4: {rootCause:"端口冲突", suggestions:[...]}
note right: 缓存命中!\n响应时间 < 50ms

DiagSvc4 -> MySQL4: UPDATE t_diagnosis_cache\nSET hit_count = hit_count + 1\nWHERE log_hash = ?

DiagSvc4 --> DiagCtrl: DiagnosisResult{fromCache:true}
deactivate DiagSvc4

DiagCtrl --> Dev: 200 OK\n{fromCache:true, diagnosis:{...}}
deactivate DiagCtrl

note over Dev
  缓存命中优势:
  - 响应时间: <50ms (vs 首次8s)
  - 无需调用Ollama
  - 节省GPU资源
end note

' ============================================
' 顺序图5: 系统健康检查
' ============================================
newpage 场景5: 系统健康检查

actor "运维工程师" as Ops
participant "MetricsController" as MetricsCtrl
participant "MetricsService" as MetricsSvc
participant "DockerSensor" as Sensor5
database "MySQL" as MySQL5
database "Redis" as Redis5

Ops -> MetricsCtrl: GET /api/metrics/health
activate MetricsCtrl

MetricsCtrl -> MetricsSvc: checkHealth()
activate MetricsSvc

par 并行检查
    MetricsSvc -> MySQL5: SELECT 1
    MySQL5 --> MetricsSvc: OK
and
    MetricsSvc -> Redis5: PING
    Redis5 --> MetricsSvc: PONG
and
    MetricsSvc -> Sensor5: getMetrics()
    Sensor5 -> Sensor5: docker info
    Sensor5 --> MetricsSvc: SystemMetrics
end

MetricsSvc -> MetricsSvc: aggregateHealth()

MetricsSvc --> MetricsCtrl: HealthStatus{db:UP, redis:UP, docker:UP}
deactivate MetricsSvc

MetricsCtrl --> Ops: 200 OK\n{status:UP, components:{...}}
deactivate MetricsCtrl

@enduml
